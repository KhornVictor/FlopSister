# Copy this file to .env for local development.
# Do NOT commit .env to version control (it is listed in .gitignore).

# Required HS256 JWT signing secret (must be at least 32 characters).
# Generate a strong secret with: openssl rand -base64 48
JWT_SECRET=change-me-min-32-chars

# Seed account passwords for DataInitializer (admin and alice).
SHOP_SEED_ADMIN_PASSWORD=ChangeMeAdmin123
SHOP_SEED_CUSTOMER_PASSWORD=ChangeMeAlice123
